{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "*": ["./src/*"],
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "navigations/*": ["./src/navigations/*"],
      "containers/*": ["./src/containers/*"],
      "styles/*": ["./src/styles/*"],
      "utils/*": ["./src/utils/*"],
      "api/*": ["./src/api/*"],
      "screens/*": ["./src/screens/*"],
      "services/*": ["./src/services/*"],
      "store/*": ["./src/store/*"],
      "hooks/*": ["./src/hooks/*"],
    },
    "allowImportingTsExtensions": false,
    "module": "esnext",
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
