{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["./src/*"],
      "*": ["./src/*"],
      "assets/*": ["./src/assets/*"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
