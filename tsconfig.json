{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "*": ["./src/*"],
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "navigations/*": ["./src/navigations/*"],
      "containers/*": ["./src/containers/*"],
      "styles/*": ["./src/styles/*"],
      "utils/*": ["./src/utils/*"],
      "api/*": ["./src/api/*"],
      "screens/*": ["./src/screens/*"],
      "services/*": ["./src/services/*"],
      "store/*": ["./src/store/*"],
      "hooks/*": ["./src/hooks/*"],
    },
    "allowImportingTsExtensions": false,
    "module": "esnext",
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": [
    "__mocks__/**/*",
    "./src/**/*",
    "index.d.ts",
    ".eslint.config.js",
    "jest.setup.js",
    "jest.config.js",
    "babel.config.js",
    "index.js",
    "react-native.config.js",
    "jest.setup.ts"
  ],
  "exclude": ["node_modules", "_", "android", "ios"]
}
