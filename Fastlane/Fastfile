require 'json'

import './APPCONST'

# Fastlane update
update_fastlane

###################### SETUP ######################
dir = File.expand_path('..', Dir.pwd).freeze

# app.json (expo.version) is the single source of truth for the app version
# name on both platforms — see CLAUDE.md §0.3. Previously this was a second,
# independently-drifting literal here that disagreed with the native project.
app_json = JSON.parse(File.read(File.join(dir, 'app.json')))
APP_VERSION_NAME = app_json['expo']['version'].freeze
XCODE_PROJECT_PATH = "ios/#{PROJECT_NAME}.xcodeproj".freeze
XCODE_WORKSPACE_PATH = "ios/#{PROJECT_NAME}.xcworkspace".freeze
RELEASE_SCHEME_NAME = "#{PROJECT_NAME}".freeze
BUILT_PRODUCTS_PATH = "#{dir}/build".freeze
BUILT_DSYM_IOS = "#{dir}/build/#{PROJECT_NAME}.app.dSYM.zip".freeze ##sdc.app.dSYM.zip

###################### BEFORE ALL ######################
before_all do

  	print "### Yarn install..  \n"
  	yarn(command: "install", package_path: "./package.json")

end

default_platform(:android)

###################### LANES ######################
platform :android do
  desc "Android staging build"
  lane :build do

	gradle(
		task: "clean",
		project_dir: "./android/"
	)

	internalVersionCode = google_play_track_version_codes(
		track: 'internal',
		json_key: "fastlane/gplayKey.json",
		package_name: AND_APP_SPECIFIER,
	)

	print "### Increasing Android \n"
	nextVersionCode = internalVersionCode.max + 1
	android_set_version_code(version_code: nextVersionCode, gradle_file: "android/app/build.gradle")
  	android_set_version_name(version_name: APP_VERSION_NAME, gradle_file: "android/app/build.gradle")
	nextAndroidVersion = get_version_code(app_project_dir: "android/app").freeze
	print "Android Next Release is #{nextAndroidVersion} \n"
	
	# gradle(
	# 	task: 'assemble',
	# 	build_type: 'Release',
	# 	project_dir: 'android/',
	# 	print_command_output: true
	# )

	gradle(
	  	task: "bundle",
	  	build_type: "Release",
	  	project_dir: "android/",
	  	print_command_output: true
	)

	upload_to_play_store(
	  	json_key: "fastlane/gplayKey.json",
	  	aab: "android/app/build/outputs/bundle/release/app-release.aab",
	  	package_name: AND_APP_SPECIFIER,
	  	track: "internal",
	  	rollout: "1",
	)
	


	sentry_config = property_file_read(file: "./android/sentry.properties")
	# sentry_upload_dsym(
	# 	auth_token: sentry_config["auth.token"],
	# 	org_slug: sentry_config["defaults.org"],
	# 	project_slug: sentry_config["defaults.project"],
	# 	path: './android/app/build/outputs/bundle/release/app-release.dSYM.zip',
	# )
	
	# git_add(path: ["./"])
	# git_commit(path: ["./"], message: "FASTLANE: Fixes and updates ", allow_nothing_to_commit: true)
	# push_to_git_remote

  end

end

########################## iOS LANES ##########################
platform :ios do
	desc "Build and push build to TestFlight"
	lane :beta do
		# Dir.chdir("..") do
		# 	# code here runs in the parent directory
		# 	sh "rm ./ios/Podfile.lock"
		# end
		cocoapods(
			podfile: 'ios/Podfile',
			use_bundle_exec: false,
			repo_update: true,
		)


		api_key = app_store_connect_api_key(
			key_id: "KGY3AYRK6Q",
			issuer_id: "4ba066ad-c175-453a-9d25-67ca2af4a072",
			key_filepath: "fastlane/AuthKey_KGY3AYRK6Q.p8",
			duration: 1200, # optional (maximum 1200)
			in_house: false # optional but may be required if using match/sigh
		)

		increment_version_number(
			version_number: APP_VERSION_NAME,
			xcodeproj: XCODE_PROJECT_PATH,
		)

		nextVersion = latest_testflight_build_number(
			app_identifier: IOS_APP_SPECIFIER,
			version: APP_VERSION_NAME,
			api_key: api_key,
		) + 1

		print "IOS Next Release is #{nextVersion} \n"

		increment_build_number(xcodeproj: XCODE_PROJECT_PATH, build_number: nextVersion)
		
		update_project_team(
			path: XCODE_PROJECT_PATH,
			teamid: "3DW44UVK42"
		)

		build_app(
			workspace: XCODE_WORKSPACE_PATH,
			scheme: RELEASE_SCHEME_NAME,
			output_directory: BUILT_PRODUCTS_PATH,
			clean: true,
			silent: true,
			suppress_xcode_output: true,
			xcargs: ' -allowProvisioningUpdates '
		)

		changelog = changelog_from_git_commits(
			commits_count: 6,
			quiet: true,
			# merge_commit_filtering: "exclude_merges"
		)

		upload_to_testflight(
			skip_waiting_for_build_processing: true,
			wait_processing_timeout_duration: 1200,
			app_identifier: IOS_APP_SPECIFIER,
			changelog: changelog,
			api_key: api_key,
		)

    sentry_config = property_file_read(file: "./android/sentry.properties")

    notification(subtitle: "Finished Building IOS", message: "#{PROJECT_NAME} #{APP_VERSION_NAME}_#{nextVersion}")

    # upload the downloaded dSYMs to sentry
    sentry_upload_dsym(
      auth_token: sentry_config["auth.token"],
      org_slug: sentry_config["defaults.org"],
      project_slug: sentry_config["defaults.project"],
			dsym_path: BUILT_DSYM_IOS,
      # dsym_path: BUILT_DSYM_IOS,
      # path: BUILT_DSYM_IOS,
      # app_identifier: IOS_APP_SPECIFIER,
    )
	end
end
